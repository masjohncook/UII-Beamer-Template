% Define frame title and subtitle layout
\setbeamertemplate{frametitle}{%
  \vspace*{-3.5ex}
  \begin{beamercolorbox}[leftskip=2cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle\\
    % Setting an invisible placeholder subtitle will fix the title in a constant position
    % This is due to the way the default template is defined in `beamerouterthemedefault.sty'
    \ifx\insertframesubtitle\empty
    \usebeamerfont{framesubtitle}\usebeamercolor[bg]{normal text}Placeholder
    \else
    \usebeamerfont{framesubtitle}\insertframesubtitle
    \fi
  \end{beamercolorbox}
}

% Define the title page
\setbeamercolor{title}{bg=}
\setbeamertemplate{title page}{%
  
  \vskip-50pt%
  \hspace{-12mm}% Pull back the box in an inelegant way - but it works!
  \begin{beamercolorbox}[wd=\titleboxwidth,sep=10pt,leftskip=8mm]{title}%
    {\usebeamerfont{title}\setstretch{1.4}\inserttitle}

    \vspace{100pt}
    {\usebeamerfont{subtitle}\insertsubtitle}
  
    % {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}
  
    

    % Add a horizontal rule (separator) here
    \vspace{15pt} %for the Student and Advisor
    % \vspace{80pt} %for the normal author
    % {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}

     % Custom author format for Instructor or Presenter
     % Uncomment this block if you present this and are not delivering a course
    % {\usebeamerfont{author}\usebeamercolor[fg]{author}%
    %   \vspace{20pt}
    %   \textbf{Presenter:} \par
    %   <Your Name> \par
    % }
    % Uncomment this block if you are a instructor of a course
    {\usebeamerfont{author}\usebeamercolor[fg]{author}%
      \textbf{Course Name:} \par
      <Course Code>-<Course Name> \par
      \vspace{5pt} % Space between student and advisor
      \textbf{Instructor:} \par
      Prof. <John Doe> \par
    }
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
  \end{beamercolorbox}
}

\newcommand{\TikzSplitSlide}[1]{%
  \rule{0.55\paperwidth}{0pt}%
  \begin{tikzpicture}
    \clip (-0.1\paperwidth,-0.5\paperheight) -- 
          ( 0.5\paperwidth,-0.5\paperheight) -- 
          ( 0.5\paperwidth, 0.5\paperheight) -- 
          ( 0.1\paperwidth, 0.5\paperheight) -- cycle; 
    \node at (0.15\paperwidth,0) {%
      \includegraphics[height=\paperheight]{#1}%
    };
  \end{tikzpicture}
}

\newbool{splittitle}
\newcommand{\@TitleBackground}{}
\newcommand{\titlebackground}{\@ifstar{\SplitBackground}{\FullBackground}}
\newcommand{\FullBackground}[1]{\renewcommand{\@TitleBackground}{#1}}
\newcommand{\SplitBackground}[1]{%
	\booltrue{splittitle}%
	\renewcommand{\@TitleBackground}{#1}%
}

\renewcommand{\maketitle}{
\begingroup
  \ifdefempty{\@TitleBackground}{}{% Skip if \@TitleBackground is empty
    \setbeamertemplate{background}{%
      \ifbool{splittitle}{%
        \TikzSplitSlide{\@TitleBackground}
      }{% Normal, full-screen background
        \includegraphics[width=\paperwidth]{\@TitleBackground}
        % \includegraphics[height=\paperheight]{\@TitleBackground}
      }
    }
  }
  \begin{frame}%
  \titlepage%
  \end{frame}%
\endgroup
}

\newenvironment{chapter}[3][]{% Args: image (optional), color, frame title
  \begingroup
  \themecolor{dark}
  \setbeamertemplate{footline}{}
  \ifstrequal{#2}{sinteflightgreen}{ % Use blue text on light green, else white
    \setbeamercolor{frametitle}{fg=uiiblue}
    \setbeamercolor{normal text}{fg=uiiblue,bg=#2}
  }{
    \setbeamercolor{frametitle}{fg=white}
    \setbeamercolor{normal text}{fg=white,bg=#2}
  }
  \ifstrempty{#1}{}{\setbeamertemplate{background}{\TikzSplitSlide{#1}}}
  \setbeamertemplate{frametitle}{}%
  \begin{frame}[t]{#3}%
  \vspace*{6ex}%
  \hspace*{0.05\textwidth}%
  \minipage{0.35\textwidth}%
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}%
  \\[0pt]%
  \usebeamercolor[fg]{normal text}%
}{%
  \endminipage
  \end{frame}
  \endgroup
  \usebeamercolor[fg]{normal text}
}

\newenvironment{sidepic}[2]{% Args: image, frame title
  \begingroup
  \setbeamertemplate{background}{%
  \hspace*{0.6\paperwidth}%
  \includegraphics[height=\paperheight]{#1}%
  }
  \setbeamertemplate{frametitle}{% Same as normal, but with right skip
    \vspace*{-3.5ex}
    \begin{beamercolorbox}[leftskip=2cm,rightskip=0.4\textwidth]{frametitle}%
      \usebeamerfont{frametitle}\insertframetitle\\
      % Setting an invisible placeholder subtitle will fix the title in a constant position
      % This is due to the way the default template is defined in `beamerouterthemedefault.sty'
      \ifx\insertframesubtitle\empty
      \usebeamerfont{framesubtitle}\usebeamercolor[bg]{normal text}Placeholder
      \else
      \usebeamerfont{framesubtitle}\insertframesubtitle
      \fi
    \end{beamercolorbox}
  }
  \begin{frame}{#2}
  \minipage{0.6\textwidth}%
}{%
  \endminipage
  \end{frame}
  \endgroup
}

