\RequirePackage{etoolbox}
\RequirePackage{tikz}

% Force 16:9 aspect ratio
\RequirePackage{geometry}
\geometry{paperwidth=16cm,paperheight=9cm}

\RequirePackage{uiifont}
\renewcommand{\familydefault}{\sfdefault}

\RequirePackage{graphicx,uiicolor}

% No navigation symbols
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{page number in head/foot}[totalframenumber]%

\newcommand{\@footlinepayoff}{\usebeamertemplate{page number in head/foot}}
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\textwidth,ht=3mm,dp=2mm,rightskip=1cm]{footline}
  \usebeamerfont{footline}\hfill\@footlinepayoff
  \end{beamercolorbox}
}

% Set footline AND coordinate blocks with it
\newcommand{\footlinecolor}[1]{% if #1 is empty, makes footline transparent
  \ifstrempty{#1}{%
    \renewcommand{\@footlinepayoff}{}
    \setbeamercolor{footline}{bg=}
    \setbeamercolor{block title}{fg=white,bg=uiiblue}
    \setbeamercolor{block body}{fg=white,bg=uiiblue}
  }{
    \renewcommand{\@footlinepayoff}{\usebeamertemplate{page number in head/foot}}
    \setbeamercolor{footline}{fg=white,bg=#1}
    \setbeamercolor{block title}{fg=white,bg=#1}
    \setbeamercolor{block body}{fg=white,bg=#1}
  }%
}
\footlinecolor{} % Default: no footline

\pgfdeclareimage[width=0.07\paperwidth]{bluelogo}{images/UII_Biru.png}
\pgfdeclareimage[width=0.1\paperwidth]{whitelogo}{images/Logo_Resmi_UII_Putih.png}
\pgfdeclareimage[width=0.1\paperwidth]{nologo}{images/placeholder.png}
% \pgfdeclareimage[width=0.1\paperwidth]{speedlab}{images/footer_logo}
\newcommand{\@uiilogo}{bluelogo}
% \newcommand{\@speedlab}{speedlab}

% Set colours
% NOTE! Beamer colors should be set in the preamble. It often works fine in the 
%       document itself, but NOT for normal text foreground.
%       \themecolor should only be called from the preamble.
\newcommand{\themecolor}[1]{
	\ifstrequal{#1}{dark}{%
		\setbeamercolor{normal text}{fg=white,bg=uiiblue}
		\setbeamercolor{structure}{fg=white}
		\renewcommand{\@uiilogo}{whitelogo}
		\setbeamercolor{block title}{fg=uiiblue,bg=steelgray}
		\setbeamercolor{block body}{fg=uiiblue,bg=steelgray}
		\usebeamercolor[fg]{normal text}
	}{}
	\ifstrequal{#1}{light}{%
		\setbeamercolor{normal text}{fg=steelgray,bg=white}
		\setbeamercolor{structure}{fg=steelgray}
		\renewcommand{\@uiilogo}{bluelogo}
		\setbeamercolor{block title}{fg=white,bg=uiiblue}
		\setbeamercolor{block body}{fg=white,bg=uiiblue}
		\usebeamercolor[fg]{normal text}
	}{}
	\ifstrequal{#1}{lightnologo}{%
		\setbeamercolor{normal text}{fg=uiiblue,bg=white}
		\setbeamercolor{structure}{fg=uiiblue}
		\renewcommand{\@uiilogo}{nologo}
		\setbeamercolor{block title}{fg=white,bg=uiiblue}
		\setbeamercolor{block body}{fg=white,bg=uiiblue}
		\usebeamercolor[fg]{normal text}
	}{}
}
\themecolor{light}

\setbeamerfont{title}{size=\LARGE,  series=\bfseries}
\setbeamercolor{title}{fg=steelgray,bg=white}
\setbeamercolor{alerted text}{fg=uiired}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}

\setbeamerfont{author}{size=\small}
\setbeamerfont{date}{size=\tiny}
\setbeamerfont{title}{series=\bfseries}
\setbeamerfont{subtitle}{series=\mdseries,size=\footnotesize}
\setbeamerfont{frametitle}{series=\bfseries}
\setbeamerfont{framesubtitle}{series=\mdseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{series=\centering\bfseries}

% Code to get prettier boxes
\setbeamertemplate{blocks}[rounded]

% Bullets in several levels
\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{\textemdash}
\setbeamertemplate{itemize subsubitem}{\ensuremath{\circ}}

\newenvironment{colorblock}[3][white]{%
	\begingroup
	\setbeamercolor{block title}{fg=#1,bg=#2}
	\setbeamercolor{block body} {fg=#1,bg=#2}
	\begin{block}{#3}
	}{%
	\end{block}
	\endgroup
}

